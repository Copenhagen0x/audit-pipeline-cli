[Unit]
Description=Jelleo - 24-hour cadence report dispatch
Documentation=https://jelleo.com/methodology.html#reporting
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Round-2 fix (devils-advocate HIGH #5): block Python user-site path-hijack on
# this Python-invoking service. Original Patch #1 missed it.
Environment=PYTHONNOUSERSITE=1
WorkingDirectory=/root/audit_runs/percolator-live
# Audit-001 follow-up (R5b-2026-05-24): real sandboxing (see jelleo-shadow.service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ExecStart=/bin/bash -c 'source /root/.audit-env && exec audit-pipeline --workspace /root/audit_runs/percolator-live scheduler tick --cadence 24h'
StandardOutput=append:/root/audit_runs/percolator-live/scheduler/24h.log
StandardError=append:/root/audit_runs/percolator-live/scheduler/24h.log
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
