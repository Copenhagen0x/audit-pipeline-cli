[Unit]
Description=Jelleo - daemon health check (one-shot)
Documentation=https://github.com/Copenhagen0x/audit-pipeline-cli
# Health-check crashes are invisible without this. Exit code 2 means
# degradation per `audit-pipeline health` — that's the EXPECTED unhappy
# path and is captured via webhook inside the command itself. OnFailure
# here covers the unexpected: the command itself crashing.
OnFailure=jelleo-alert-failure@%n.service

[Service]
Type=oneshot
User=root
# Round-2 fix (devils-advocate HIGH #5): block Python user-site path-hijack.
Environment=PYTHONNOUSERSITE=1
# Round-3 systemic hardening: explicit PATH (no /root/.local/bin) closes
# the binary-hijack vector via `source /root/.audit-env`. Without this,
# `audit-pipeline` resolution would follow the EnvironmentFile-provided PATH.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/root/audit_runs/percolator-live
# Audit-001 follow-up (R5b-2026-05-24): real sandboxing (see jelleo-shadow.service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ExecStart=/bin/bash -c 'source /root/.audit-env && exec audit-pipeline --workspace /root/audit_runs/percolator-live health --silent'
StandardOutput=journal
StandardError=journal
