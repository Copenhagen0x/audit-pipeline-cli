[Unit]
Description=Jelleo - dashboard snapshot writer (DB -> jelleo.com/snapshot.json)
Documentation=https://jelleo.com/methodology.html#reporting
After=network-online.target
Wants=network-online.target
# Silent snapshot failures freeze the dashboard. Alert via the
# templated handler so operators see degradation in real time.
OnFailure=jelleo-alert-failure@%n.service

[Service]
Type=oneshot
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Round-2 fix (devils-advocate HIGH #5): block Python user-site path-hijack
# on the dashboard.py path (OSec bridge file — extra-sensitive per
# sacred-zones rules). Without this, a shim in /root/.local/lib/pythonX.Y
# intercepts the dashboard output.
Environment=PYTHONNOUSERSITE=1
# Audit-001 R5b-2 (2026-05-24): both reviewers found I missed snapshot
# in the first R5b pass (NINE_DAEMONS list excluded it). It runs every
# 60s as root, writes to /var/www/jelleo.com/ + touches the OSec bridge
# `dashboard.py` — highest-frequency root daemon after watch. Adding
# the same baseline sandbox as the other root daemons. /var is
# writable under ProtectSystem=full so the snapshot.json write to
# /var/www works.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
WorkingDirectory=/root/audit_runs/percolator-live
# Writes a public-safe JSON snapshot of the findings DB to the path served
# by the website. The dashboard.html page on jelleo.com fetches this every
# 60s and patches in live numbers (with mockup fallback when missing).
#
# Round-7 fix (devils-advocate ROUND-7 HIGH #1, cross-service shadow): the
# write-path env vars JELLEO_SNAPSHOT_PATH / CUSTOMER_DIR / CYCLES_DIR are
# now HARDCODED inside the bash command AFTER the `source /root/.audit-env`,
# so an attacker writing to /root/.audit-env cannot override them. Operator
# who wants to customize MUST edit this unit file directly (privileged).
# We can't use systemd Environment= directives for the shadow because the
# `source` overrides them — the shadow has to happen AFTER source inside
# the same bash invocation.
ExecStart=/bin/bash -c 'source /root/.audit-env && JELLEO_SNAPSHOT_PATH="/var/www/jelleo.com/snapshot.json" && JELLEO_CUSTOMER_DIR="/var/www/jelleo.com/customer" && JELLEO_CYCLES_DIR="/var/www/jelleo.com/cycles" && exec audit-pipeline --workspace /root/audit_runs/percolator-live dashboard --output /root/audit_runs/percolator-live/dashboard.html --extra-db /root/audit_runs/ottersec-eval/findings.db --snapshot-json "$JELLEO_SNAPSHOT_PATH" --customer-manifest-dir "$JELLEO_CUSTOMER_DIR" --cycles-dir "$JELLEO_CYCLES_DIR"'
StandardOutput=append:/root/audit_runs/percolator-live/scheduler/snapshot.log
StandardError=append:/root/audit_runs/percolator-live/scheduler/snapshot.log
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
